{
  "name": "@openmana/app",
  "version": "0.1.0",
  "private": true,
  "description": "OpenMana web application (PWA): the user interface. Talks to Forge only through engine/protocol and engine/client; the engine itself is built in engine/.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-schemas.ts --check && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e/run.ts",
    "test:pwa": "node scripts/e2e/pwa.ts",
    "generate": "node scripts/generate-schemas.ts",
    "cards:build": "node cards/scripts/build-catalog.ts",
    "icons": "python3 scripts/gen-app-icons.py",
    "check": "node scripts/generate-schemas.ts --check && tsc -b && oxlint && vitest run && node scripts/e2e/run.ts && node scripts/e2e/pwa.ts --no-build"
  },
  "dependencies": {
    "@fontsource-variable/cinzel": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "idb": "8.0.3",
    "lucide-react": "1.48.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "axe-core": "4.13.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.1",
    "json-schema-to-typescript": "16.0.0",
    "oxlint": "1.85.0",
    "playwright-core": "1.63.0",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  }
}
