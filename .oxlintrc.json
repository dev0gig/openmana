{
  // oxlint (Oxc): correctness checks for the app and its tooling, with the
  // React hooks rules. ESLint's TypeScript parser (typescript-eslint) does
  // not support TypeScript 7 yet; oxlint needs no TypeScript API.
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "jsx-a11y", "typescript", "unicorn", "oxc", "import"],
  "categories": { "correctness": "error" },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    // shadcn composes semantic roles on its div-based components (Item
    // groups as list/listitem, the sidebar as navigation); axe checks the
    // rendered result in the end-to-end test.
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "ignorePatterns": ["dist/**", "reports/**", "engine/**", "src/storage/generated/**"],
  "overrides": [
    {
      // Generated by shadcn/ui and kept as generated.
      "files": ["src/hooks/use-mobile.ts"],
      "rules": { "react/set-state-in-effect": "off" }
    }
  ]
}
