+/*
+ * Forge: Play Magic: the Gathering.
+ * Copyright (C) 2011 Forge Team
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * OpenMana patch 0009 (2026-10-08): shared read-only assignment policy.
+ *
+ * Assignment policy extracted from the desktop VAssignCombatDamage dialog.
+ * Both that dialog and headless clients use these answers; clients do not
+ * reproduce lethal-damage, trample or combatant-order rules.
+ */
+package forge.gamemodes.match;
+
+import forge.game.GameEntityView;
+import forge.game.card.CardView;
+import java.util.ArrayList;
+import java.util.List;
+
+public final class CombatDamageAssignment {
+    /** Zero-based item indices; before item receives damage, requires needs amount. */
+    public record Prerequisite(int item, int requires, int amount) { }
+
+    private final boolean defenderAllowed;
+    private final List<Prerequisite> prerequisites = new ArrayList<>();
+
+    public CombatDamageAssignment(final CardView attacker, final List<CardView> blockers,
+                                  final GameEntityView defender, final boolean overrideOrder) {
+        final boolean divide = attacker.getCurrentState().hasDivideDamage();
+        defenderAllowed = defender != null && (attacker.getCurrentState().hasTrample() || (divide && overrideOrder));
+        final int count = blockers.size() + (defenderAllowed ? 1 : 0);
+        for (int i = 0; i < count; i++) {
+            if (divide && overrideOrder) continue;
+            if (overrideOrder && i < blockers.size()) continue;
+            for (int j = 0; j < i; j++) {
+                prerequisites.add(new Prerequisite(i, j,
+                        lethal(blockers.get(j), attacker.getCurrentState().hasDeathtouch())));
+            }
+        }
+    }
+
+    public boolean defenderAllowed() { return defenderAllowed; }
+    public List<Prerequisite> prerequisites() { return List.copyOf(prerequisites); }
+
+    public boolean mayAssignTo(final int item, final List<Integer> amounts) {
+        for (final Prerequisite p : prerequisites) {
+            if (p.item() == item && amounts.get(p.requires()) < p.amount()) return false;
+        }
+        return true;
+    }
+
+    /** Forge's view already includes marked/assigned damage and current toughness. */
+    public static int lethal(final CardView card, final boolean deathtouch) {
+        int result = Math.max(0, card.getLethalDamage());
+        if (card.getCurrentState().isPlaneswalker()) {
+            result = Integer.parseInt(card.getCurrentState().getLoyalty());
+        } else if (deathtouch) {
+            result = Math.min(result, 1);
+        }
+        return result;
+    }
+}
