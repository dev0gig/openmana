@@ -196,19 +196,60 @@ public class CombatUtil {
     }
 
     private static boolean canAttack(final Card attacker, final GameEntity defender, final boolean forNextTurn) {
+        // OpenMana patch 0008 (2026-09-29): the checks moved unchanged, in the same order, into attackRefusal.
+        return attackRefusal(attacker, defender, forNextTurn) == null;
+    }
+
+    /**
+     * OpenMana patch 0008 (2026-09-29): why a creature may not attack a
+     * defender now - the check of {@link #canAttack(Card, GameEntity)}, which
+     * refuses exactly when this names a reason. A GUI can say why a creature
+     * is not offered as an attacker instead of guessing.
+     */
+    public enum AttackRefusal {
+        /** Not a creature, or a battle. */
+        NOT_A_CREATURE,
+        TAPPED,
+        PHASED_OUT,
+        /** Summoning sickness (no haste, no effect lets it attack anyway). */
+        SICK,
+        /** The declaration of attackers is over. */
+        TOO_LATE,
+        /** Goaded: it must attack a player who did not goad it. */
+        GOADED,
+        /** A keyword or static ability says it can't attack (this defender). */
+        CANT_ATTACK
+    }
+
+    /** OpenMana patch 0008 (2026-09-29): why canAttack(attacker, defender) refuses, or null if it does not. */
+    public static AttackRefusal attackRefusal(final Card attacker, final GameEntity defender) {
+        return attackRefusal(attacker, defender, false);
+    }
+
+    private static AttackRefusal attackRefusal(final Card attacker, final GameEntity defender, final boolean forNextTurn) {
         final Game game = attacker.getGame();
 
         if (attacker.isBattle()) {
-            return false;
+            return AttackRefusal.NOT_A_CREATURE;
         }
 
         // Basic checks (unless is for next turn)
-        if (!forNextTurn &&
-                (!attacker.isCreature()
-                || attacker.isTapped() || attacker.isPhasedOut()
-                || isAttackerSick(attacker, defender)
-                || game.getPhaseHandler().getPhase().isAfter(PhaseType.COMBAT_DECLARE_ATTACKERS))) {
-            return false;
+        if (!forNextTurn) {
+            if (!attacker.isCreature()) {
+                return AttackRefusal.NOT_A_CREATURE;
+            }
+            if (attacker.isTapped()) {
+                return AttackRefusal.TAPPED;
+            }
+            if (attacker.isPhasedOut()) {
+                return AttackRefusal.PHASED_OUT;
+            }
+            if (isAttackerSick(attacker, defender)) {
+                return AttackRefusal.SICK;
+            }
+            if (game.getPhaseHandler().getPhase().isAfter(PhaseType.COMBAT_DECLARE_ATTACKERS)) {
+                return AttackRefusal.TOO_LATE;
+            }
         }
 
         // Goad logic
@@ -223,7 +264,7 @@ public class CombatUtil {
                         // found a player which does not goad that creature
                         // and creature can attack this player or planeswalker
                         if (!attacker.isGoadedBy((Player) ge) && canAttack(attacker, ge)) {
-                            return false;
+                            return AttackRefusal.GOADED;
                         }
                     }
                 }
@@ -232,10 +273,10 @@ public class CombatUtil {
 
         // CantAttack static abilities
         if (StaticAbilityCantAttackBlock.cantAttack(attacker, defender)) {
-            return false;
+            return AttackRefusal.CANT_ATTACK;
         }
 
-        return true;
+        return null;
     }
 
