<?xml version="1.0" encoding="UTF-8"?>
<!--
    Fat JAR of the engine (input for native-image and for the JVM reference
    runs). Same content as the stock "jar-with-dependencies", plus merging of
    META-INF/services files: forge-gui and tinylog-impl both register
    org.tinylog.writers.Writer implementations, and without merging Forge's
    file replaces tinylog's. tinylog then finds no console writer and every
    log line Forge writes through tinylog, errors included, is silently lost.
-->
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0 https://maven.apache.org/xsd/assembly-2.1.0.xsd">
    <id>jar-with-dependencies</id>
    <formats>
        <format>jar</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <containerDescriptorHandlers>
        <containerDescriptorHandler>
            <handlerName>metaInf-services</handlerName>
        </containerDescriptorHandler>
    </containerDescriptorHandlers>
    <dependencySets>
        <dependencySet>
            <outputDirectory>/</outputDirectory>
            <useProjectArtifact>true</useProjectArtifact>
            <unpack>true</unpack>
            <scope>runtime</scope>
        </dependencySet>
    </dependencySets>
</assembly>
